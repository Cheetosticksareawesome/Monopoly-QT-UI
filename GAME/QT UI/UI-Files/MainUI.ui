  <property name="styleSheet">
   <string>
QMainWindow, QWidget#centralwidget { background: #202625; }
QWidget { color: #e0e3dc; font-family: &quot;Segoe UI&quot;; font-size: 12px; }
QLabel { background: transparent; }
QLineEdit { background: #202625; color: #e0e3dc; border: 1px solid #788f80; border-radius: 4px; padding: 6px 8px; }
QLineEdit:focus { border: 1px solid #a4bda8; }
QFrame[tile=&quot;true&quot;] { background: #3c4540; border: 1px solid #758279; }
QFrame#boardCenter { background: #255c32; border: 1px solid #758279; }
QGroupBox { background: #303936; border: 1px solid #59675f; border-radius: 8px; margin-top: 12px; padding: 8px 6px 6px; font-weight: bold; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; color: #e0e3dc; }
QPushButton { color: #e0e3dc; background: #40554a; padding: 7px 9px; border: 1px solid #788f80; border-radius: 5px; }
QPushButton:hover { background: #4b6356; }
QPushButton:pressed { background: #34473e; }
QPushButton:focus { border: 2px solid #a4bda8; }
QPushButton:disabled { color: #a4ada5; background: #343d38; border: 1px solid #59675f; }
QLabel#diceLabel { font-size: 24px; font-weight: bold; }
QLabel#boardTitle { color: #d2dfd2; font-size: 30px; font-weight: bold; }
</string>
